{
  "name": "nuvokit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "npm run icons",
    "icons": "npm exec --workspace=@nuvokit/desktop -- tauri icon ../../design/assets/nuvokit-mark.svg",
    "dev": "npm run dev --workspace=@nuvokit/desktop",
    "build": "npm run check && npm run build --workspace=@nuvokit/desktop",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "desktop": "npm run desktop --workspace=@nuvokit/desktop",
    "desktop:build": "npm run check && npm run desktop:build --workspace=@nuvokit/desktop",
    "desktop:bundle": "npm run check && npm run desktop:bundle --workspace=@nuvokit/desktop",
    "native:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "native:check": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@webgpu/types": "^0.1.69",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
