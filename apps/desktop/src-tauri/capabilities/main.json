{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local main app window may call the versioned core commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-update-status",
    "allow-set-update-channel",
    "allow-check-update",
    "allow-download-update",
    "allow-cancel-update",
    "allow-install-update",
    "allow-get-clock",
    "allow-save-clock",
    "allow-get-storage-info",
    "allow-export-backup",
    "allow-prepare-restore",
    "allow-discard-restore",
    "allow-restore-backup",
    "allow-clear-temporary-data",
    "allow-open-data-folder",
    "allow-scan-environment",
    "allow-install-dependency",
    "allow-cancel-install",
    "allow-get-preferences",
    "allow-set-preferences",
    "allow-get-history",
    "allow-ui-ready",
    "allow-finish-verification"
  ]
}
