; NuvoKit's Vietnamese messages for Tauri's standard NSIS pages.
LangString addOrReinstall ${LANG_VIETNAMESE} "Thêm / cài lại thành phần"
LangString alreadyInstalled ${LANG_VIETNAMESE} "Đã cài đặt"
LangString alreadyInstalledLong ${LANG_VIETNAMESE} "${PRODUCTNAME} ${VERSION} đã có trên máy. Chọn thao tác rồi nhấn Tiếp tục."
LangString appRunning ${LANG_VIETNAMESE} "${PRODUCTNAME} đang chạy. Đóng ứng dụng rồi thử lại."
LangString appRunningOkKill ${LANG_VIETNAMESE} "${PRODUCTNAME} đang chạy.$\nNhấn OK để đóng ứng dụng trước khi tiếp tục."
LangString chooseMaintenanceOption ${LANG_VIETNAMESE} "Chọn thao tác bảo trì ứng dụng."
LangString chooseHowToInstall ${LANG_VIETNAMESE} "Chọn cách cài ${PRODUCTNAME}."
LangString createDesktop ${LANG_VIETNAMESE} "Tạo lối tắt trên màn hình"
LangString dontUninstall ${LANG_VIETNAMESE} "Giữ bản cài hiện tại"
LangString dontUninstallDowngrade ${LANG_VIETNAMESE} "Giữ bản hiện tại (không hỗ trợ hạ phiên bản trực tiếp)"
LangString failedToKillApp ${LANG_VIETNAMESE} "Chưa đóng được ${PRODUCTNAME}. Hãy tự đóng ứng dụng rồi thử lại."
LangString installingWebview2 ${LANG_VIETNAMESE} "Đang cài WebView2…"
LangString newerVersionInstalled ${LANG_VIETNAMESE} "Máy đã có ${PRODUCTNAME} mới hơn. Nên giữ phiên bản mới; nếu cần bản cũ, hãy gỡ bản hiện tại trước."
LangString older ${LANG_VIETNAMESE} "cũ hơn"
LangString olderOrUnknownVersionInstalled ${LANG_VIETNAMESE} "Máy đã có một bản ${PRODUCTNAME} ($R4). Có thể gỡ bản đó trước khi cài tiếp."
LangString silentDowngrades ${LANG_VIETNAMESE} "Không hỗ trợ hạ phiên bản ở chế độ im lặng. Hãy dùng bộ cài có giao diện."
LangString unableToUninstall ${LANG_VIETNAMESE} "Chưa gỡ được ứng dụng."
LangString uninstallApp ${LANG_VIETNAMESE} "Gỡ ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_VIETNAMESE} "Gỡ bản hiện tại trước khi cài"
LangString unknown ${LANG_VIETNAMESE} "chưa rõ phiên bản"
LangString webview2AbortError ${LANG_VIETNAMESE} "Chưa cài được WebView2. Khởi động lại máy rồi chạy lại bộ cài."
LangString webview2DownloadError ${LANG_VIETNAMESE} "Chưa tải được WebView2: $0"
LangString webview2DownloadSuccess ${LANG_VIETNAMESE} "Đã tải trình chuẩn bị WebView2"
LangString webview2Downloading ${LANG_VIETNAMESE} "Đang tải trình chuẩn bị WebView2…"
LangString webview2InstallError ${LANG_VIETNAMESE} "Chưa cài được WebView2, mã $1"
LangString webview2InstallSuccess ${LANG_VIETNAMESE} "Đã cài WebView2"
LangString deleteAppData ${LANG_VIETNAMESE} "Xóa cả dữ liệu NuvoKit (không thể khôi phục)"
